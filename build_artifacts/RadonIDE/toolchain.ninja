build phony/expected_grd_files: phony gen/expected_grd_files.json
rule ___favicon___build_toolchain_linux_x64__rule
  command = python3 ../../third_party/node/node.py ../../scripts/build/ninja/copy-files.js ../.. gen favicon.ico
  description = ACTION //:favicon(//build/toolchain/linux:x64)
  restat = 1
  pool = build_toolchain_action_pool

build gen/favicon.ico: ___favicon___build_toolchain_linux_x64__rule | ../../third_party/node/node.py ../../scripts/build/ninja/copy-files.js ../../scripts/build/ninja/write-if-changed.js ../../favicon.ico

build phony/favicon: phony gen/favicon.ico
rule ___frontend_indexer_tsconfig___build_toolchain_linux_x64__rule
  command = python3 ../../scripts/build/typescript/ts_library.py --tsconfig_output_location gen/frontend_indexer_tsconfig-tsconfig.json --front_end_directory ../.. --tsconfig-only --sources-list indexer_ts_files.txt
  description = ACTION //:frontend_indexer_tsconfig(//build/toolchain/linux:x64)
  restat = 1
  pool = build_toolchain_action_pool

build gen/frontend_indexer_tsconfig-tsconfig.json: ___frontend_indexer_tsconfig___build_toolchain_linux_x64__rule | ../../scripts/build/typescript/ts_library.py ../../third_party/node/node.py ../../third_party/node/node_modules.py ../../scripts/devtools_paths.py ../../config/typescript/tsconfig.base.json ../../node_modules/typescript/lib/tsc.js ../../front_end/legacy/legacy-defs.d.ts ../../front_end/global_typings/global_defs.d.ts ../../node_modules/@types/filesystem/index.d.ts ../../node_modules/@types/wicg-task-scheduling/index.d.ts phony/indexer_ts_files

build phony/frontend_indexer_tsconfig: phony gen/frontend_indexer_tsconfig-tsconfig.json
