rule copy
  command = ln -f ${in} ${out} 2>/dev/null || (rm -rf ${out} && cp -af ${in} ${out})
  description = COPY ${in} ${out}
rule asm
  command = gcc -MD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = ASM ${out}
  depfile = ${out}.d
  deps = gcc
rule alink
  command = rm -f ${out} && "ar" ${arflags} -r -c -D ${out} @"${out}.rsp"
  description = AR ${out}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule solink
  command = "python3" "../../build/toolchain/gcc_solink_wrapper.py" --readelf="readelf" --nm="nm"  --sofile="${output_dir}/${target_output_name}${output_extension}" --tocfile="${output_dir}/${target_output_name}${output_extension}.TOC" --output="${output_dir}/${target_output_name}${output_extension}" -- g++ -shared -Wl,-soname="${target_output_name}${output_extension}" ${ldflags} -o "${output_dir}/${target_output_name}${output_extension}" @"${output_dir}/${target_output_name}${output_extension}.rsp" ${rlibs} 
  description = SOLINK ${output_dir}/${target_output_name}${output_extension}
  rspfile = ${output_dir}/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
  pool = build_toolchain_link_pool
  restat = 1
rule solink_module
  command = g++ -shared ${ldflags} -o "${output_dir}/${target_output_name}${output_extension}" -Wl,-soname="${target_output_name}${output_extension}" @"${output_dir}/${target_output_name}${output_extension}.rsp"
  description = SOLINK_MODULE ${output_dir}/${target_output_name}${output_extension}
  rspfile = ${output_dir}/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs} ${rlibs}
  pool = build_toolchain_link_pool
rule link
  command = "python3" "../../build/toolchain/gcc_link_wrapper.py" --output="${output_dir}/${target_output_name}${output_extension}" -- g++ ${ldflags} -o "${output_dir}/${target_output_name}${output_extension}" -Wl,--start-group @"${output_dir}/${target_output_name}${output_extension}.rsp" -Wl,--end-group  ${solibs} ${libs} -Wl,--start-group ${rlibs} -Wl,--end-group 
  description = LINK ${output_dir}/${target_output_name}${output_extension}
  rspfile = ${output_dir}/${target_output_name}${output_extension}.rsp
  rspfile_content = ${in}
  pool = build_toolchain_link_pool
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule cc
  command =  gcc -MD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule cxx
  command =  g++ -MD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc

rule ___assert_grd___build_toolchain_linux_x64__rule
  command = python3 ../../scripts/build/assert_grd.py gen/expected_grd_files.json gen/input_grd_files.json gen/assert_grd.stamp
  description = ACTION //:assert_grd(//build/toolchain/linux:x64)
  restat = 1
  pool = build_toolchain_action_pool

build gen/assert_grd.stamp: ___assert_grd___build_toolchain_linux_x64__rule | ../../scripts/build/assert_grd.py gen/expected_grd_files.json gen/input_grd_files.json phony/expected_grd_files phony/input_grd_files

build phony/assert_grd: phony gen/assert_grd.stamp
rule ___assert_third_party_readmes___build_toolchain_linux_x64__rule
  command = python3 ../../scripts/build/assert_third_party_readmes.py gen/expected_grd_files.json ../../front_end/third_party/additional_readme_paths.json gen/assert_third_party_readmes.stamp
  description = ACTION //:assert_third_party_readmes(//build/toolchain/linux:x64)
  restat = 1
  pool = build_toolchain_action_pool

build gen/assert_third_party_readmes.stamp: ___assert_third_party_readmes___build_toolchain_linux_x64__rule | ../../scripts/build/assert_third_party_readmes.py gen/expected_grd_files.json ../../front_end/third_party/additional_readme_paths.json phony/expected_grd_files

build phony/assert_third_party_readmes: phony gen/assert_third_party_readmes.stamp
